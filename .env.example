# ===================================================================
# AI Schedule Auditor - Environment Variables
# ===================================================================
# Copy this file to .env and modify as needed
# Never commit your .env file to version control
# ===================================================================

# -------------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------------
# These defaults work with the included Docker setup
# For production, use a managed PostgreSQL service
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -------------------------------------------------------------------
# Generate a secure secret key for Better Auth
# Use: openssl rand -base64 32
BETTER_AUTH_SECRET=your_very_secure_secret_key_here_minimum_32_characters

# Development URLs (update for production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# -------------------------------------------------------------------
# AI CONFIGURATION (REQUIRED FOR CHAT FUNCTIONALITY)
# -------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# This is required for the AI chat interface to work
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Choose your preferred OpenAI model
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4-turbo
# OPENAI_MODEL=gpt-4-turbo

# -------------------------------------------------------------------
# NEXT.JS CONFIGURATION
# -------------------------------------------------------------------
# Next.js runtime environment
NODE_ENV=development

# Next.js secret for session encryption (generate new one for production)
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_32_chars

# -------------------------------------------------------------------
# OPTIONAL CONFIGURATIONS
# -------------------------------------------------------------------
# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Enable/disable AI usage analytics
AI_ANALYTICS_ENABLED=true

# Rate limiting for API endpoints (requests per minute)
RATE_LIMIT_RPM=60

# -------------------------------------------------------------------
# PRODUCTION OVERRIDES
# -------------------------------------------------------------------
# For production deployment, uncomment and update these values:

# DATABASE_URL=postgresql://username:password@your-host:5432/database_name
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# NODE_ENV=production